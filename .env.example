# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit .env ke repository.

# ===== Dev (Nuxt langsung di host) =====
DATABASE_URL="mysql://root:rootpassword@localhost:3306/rental_ps?timezone=Z"
NUXT_SESSION_PASSWORD="ganti-dengan-secret-kuat"

# ===== Docker Compose (MariaDB) =====
MYSQL_ROOT_PASSWORD="ganti-root-password"
MYSQL_DATABASE="rental_ps"
DB_USER="rentalps"
DB_PASSWORD="ganti-password-app"
APP_URL="http://localhost:8082"
